#!/bin/bash
set -euo pipefail
device=${1:-}
if [[ -z $device ]]; then
  mapfile -t devices < <(blkid -t TYPE=crypto_LUKS -o device)
  ((${#devices[@]})) || { echo 'No LUKS devices found' >&2; exit 1; }
  device=$(printf '%s\n' "${devices[@]}" | gum choose --header 'Select LUKS volume') || exit 1
fi
[[ -b $device && $(blkid -s TYPE -o value "$device") == "crypto_LUKS" ]] || { echo "Not a LUKS device: $device" >&2; exit 2; }
printf 'Change the LUKS passphrase on %s? Type the exact device path: ' "$device"
read -r confirmation
[[ $confirmation == "$device" ]] || { echo 'Cancelled'; exit 1; }
sudo cryptsetup luksChangeKey --pbkdf argon2id --iter-time 2000 "$device"

