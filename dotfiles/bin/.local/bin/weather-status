#!/bin/bash
set -euo pipefail

mode=${1:---text}
cache_dir=${WEATHER_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/weather-status}
cache_file="$cache_dir/weather.json"
cache_location_file="$cache_dir/location"
location_file=${WEATHER_LOCATION_FILE:-$HOME/.config/weather-status/location}
location_label_file=${WEATHER_LOCATION_LABEL_FILE:-$HOME/.config/weather-status/location-label}
cache_max_age=${WEATHER_CACHE_MAX_AGE:-900}

case $mode in
  --json|--text|--detail) ;;
  *) printf 'Usage: weather-status [--json|--text|--detail]\n' >&2; exit 2 ;;
esac

location=""
[[ -s $location_file ]] && location=$(<"$location_file")
location=${location//$'\r'/}
configured_label=""
[[ -s $location_label_file ]] && configured_label=$(<"$location_label_file")
configured_label=${configured_label//$'\r'/}

mkdir -p "$cache_dir"

cache_matches_location() {
  [[ -s $cache_file && -f $cache_location_file ]] || return 1
  [[ $(<"$cache_location_file") == "$location" ]] || return 1
  jq -e '.current.temperature_2m != null and .daily.time[0]' "$cache_file" >/dev/null 2>&1
}

cache_is_fresh() {
  cache_matches_location || return 1
  [[ $cache_max_age =~ ^[0-9]+$ ]] || return 1
  modified=$(stat -c %Y "$cache_file" 2>/dev/null) || return 1
  (( $(date +%s) - modified < cache_max_age ))
}

# Sets lat, lon, ip_label. "~LAT,LON" is written by weather-location; anything
# else (empty = automatic) is located by IP.
resolve_coordinates() {
  ip_label=""
  if [[ $location =~ ^~(-?[0-9.]+),(-?[0-9.]+)$ ]]; then
    lat=${BASH_REMATCH[1]} lon=${BASH_REMATCH[2]}
    return 0
  fi
  local ip
  ip=$(curl -A 'arch-setup-weather/1.0' -fsS --max-time 8 https://ipinfo.io/json 2>/dev/null) || return 1
  IFS=$'\t' read -r lat lon ip_label < <(
    jq -r '(.loc // "" | split(",")) as $c |
      select($c | length == 2) |
      [$c[0], $c[1], ([.city, .region] | map(select(. != null and . != "")) | unique_by(.) | join(", "))] | @tsv' <<<"$ip"
  ) || return 1
  [[ -n ${lat:-} && -n ${lon:-} ]]
}

stale=false
if ! cache_is_fresh; then
  download=$(mktemp "$cache_dir/weather.json.XXXXXX")
  if resolve_coordinates &&
      curl -A 'arch-setup-weather/1.0' -fsS --max-time 8 -G \
        'https://api.open-meteo.com/v1/forecast' \
        --data-urlencode "latitude=$lat" --data-urlencode "longitude=$lon" \
        --data 'current=temperature_2m,apparent_temperature,relative_humidity_2m,weather_code,wind_speed_10m,wind_direction_10m,visibility' \
        --data 'daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max,uv_index_max,sunrise,sunset' \
        --data 'timezone=auto&forecast_days=2' 2>/dev/null |
      jq -ce --arg label "$ip_label" '. + {ip_label: $label}' >"$download" 2>/dev/null &&
      jq -e '.current.temperature_2m != null and .daily.time[0]' "$download" >/dev/null 2>&1; then
    mv -f "$download" "$cache_file"
    printf '%s' "$location" >"$cache_location_file"
  else
    rm -f "$download"
    cache_matches_location && stale=true
  fi
fi

if ! cache_matches_location; then
  case $mode in
    --json) jq -cn '{text:"--°C", tooltip:"Weather unavailable", class:"unavailable"}' ;;
    *) printf 'Weather unavailable\n' ;;
  esac
  exit 0
fi

temperature=$(jq -r '(.current.temperature_2m | round | tostring) + "°C"' "$cache_file")

jq_defs='
  def desc:
    if . == 0 then "Clear"
    elif . == 1 then "Mainly clear"
    elif . == 2 then "Partly cloudy"
    elif . == 3 then "Overcast"
    elif . == 45 or . == 48 then "Fog"
    elif . >= 51 and . <= 57 then "Drizzle"
    elif . >= 61 and . <= 67 then "Rain"
    elif . >= 71 and . <= 77 then "Snow"
    elif . >= 80 and . <= 82 then "Showers"
    elif . == 85 or . == 86 then "Snow showers"
    elif . >= 95 then "Thunderstorm"
    else "Unknown" end;
  def compass:
    ["N","NNE","NE","ENE","E","ESE","SE","SSE","S","SSW","SW","WSW","W","WNW","NW","NNW"][(((. + 11.25) / 22.5) | floor) % 16];
  def clock: strptime("%Y-%m-%dT%H:%M") | strftime("%I:%M %p");
  def area_name:
    if $configured_label != "" then $configured_label
    elif (.ip_label // "") != "" then .ip_label
    else "Current location" end;
  def rain($i): .daily.precipitation_probability_max[$i] // 0;
  def range($i): "\(.daily.temperature_2m_min[$i] | round)–\(.daily.temperature_2m_max[$i] | round)°C";
'

tooltip=$(jq -r --arg configured_label "$configured_label" "$jq_defs"'
  .current as $c |
  [
    area_name,
    "\($c.weather_code | desc) · \($c.temperature_2m | round)°C · feels like \($c.apparent_temperature | round)°C",
    "Humidity \($c.relative_humidity_2m)% · Wind \($c.wind_direction_10m | compass) \($c.wind_speed_10m | round) km/h",
    "Today \(range(0)) · rain \(rain(0))%",
    (if .daily.time[1] then "Tomorrow \(range(1)) · rain \(rain(1))%" else empty end)
  ] | join("\n") + "\n\nLeft click: details · Right click: change location"
' "$cache_file")

if $stale; then
  tooltip+=$'\nCached conditions · update unavailable'
fi

case $mode in
  --json)
    class=normal
    $stale && class=stale
    jq -cn --arg text "$temperature" --arg tooltip "$tooltip" --arg class "$class" \
      '{text:$text, tooltip:$tooltip, class:$class}'
    ;;
  --text)
    printf '%s\n' "$temperature"
    ;;
  --detail)
    jq -r --arg configured_label "$configured_label" "$jq_defs"'
      .current as $c |
      def day($label; $i):
        if .daily.time[$i] then
          "\($label)\n  Temperature  \(range($i))\n  Rain chance  \(rain($i))%\n  Sunrise      \(.daily.sunrise[$i] | clock)\n  Sunset       \(.daily.sunset[$i] | clock)"
        else empty end;
      "Weather · \(area_name)\n\n" +
      "Current\n" +
      "  Conditions   \($c.weather_code | desc)\n" +
      "  Temperature  \($c.temperature_2m | round)°C\n" +
      "  Feels like   \($c.apparent_temperature | round)°C\n" +
      "  Humidity     \($c.relative_humidity_2m)%\n" +
      "  Wind         \($c.wind_direction_10m | compass) \($c.wind_speed_10m | round) km/h\n" +
      "  Visibility   \(if $c.visibility != null then ($c.visibility / 1000 | round) else "—" end) km\n" +
      "  UV index     \(.daily.uv_index_max[0] // "—" | if type == "number" then round else . end)\n\n" +
      day("Today"; 0) + "\n\n" + day("Tomorrow"; 1)
    ' "$cache_file"
    if $stale; then
      printf '\n\nCached conditions · update unavailable\n'
    fi
    ;;
esac
