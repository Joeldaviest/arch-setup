#!/bin/bash
set -euo pipefail
directory=$(readlink -f "$HOME/.config/arch-setup/wallpapers")
[[ -d $directory ]] || exit 1
selection=$(find "$directory" -maxdepth 1 -type f | sort | walker --dmenu -p 'Wallpaper') || exit 0
[[ -f $selection ]] || exit 0
ln -sfn "$selection" "$HOME/.config/arch-setup/background"
pkill -x swaybg || true
setsid uwsm-app -- swaybg -i "$HOME/.config/arch-setup/background" -m fill >/dev/null 2>&1 &
