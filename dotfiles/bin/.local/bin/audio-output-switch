#!/bin/bash
set -euo pipefail
mapfile -t sinks < <(wpctl status -n | sed -n '/Sinks:/,/Sources:/s/.*[│* ]\([0-9][0-9]*\)\. \([^[]*\).*/\1|\2/p')
((${#sinks[@]})) || { desktop-osd --custom-message 'No audio devices found'; exit 1; }
current=$(wpctl inspect @DEFAULT_AUDIO_SINK@ | sed -n 's/^id \([0-9]*\),.*/\1/p')
next=${sinks[0]}
for i in "${!sinks[@]}"; do
  if [[ ${sinks[$i]%%|*} == "$current" ]]; then next=${sinks[$(((i + 1) % ${#sinks[@]}))]}; break; fi
done
wpctl set-default "${next%%|*}"
desktop-osd --custom-message "${next#*|}" --custom-icon audio-speakers-symbolic

