#!/bin/bash
set -euo pipefail

files=(
  "$HOME/.config/hypr/media.lua"
  "$HOME/.config/hypr/clipboard.lua"
  "$HOME/.config/hypr/tiling.lua"
  "$HOME/.config/hypr/bindings.lua"
)
selection=$(sed -n 's/.*hl\.bind("\([^"]*\)".*description = "\([^"]*\)".*/\1  →  \2/p' "${files[@]}" |
  sed -e 's/code:10/1/' -e 's/code:11/2/' -e 's/code:12/3/' -e 's/code:13/4/' -e 's/code:14/5/' \
      -e 's/code:15/6/' -e 's/code:16/7/' -e 's/code:17/8/' -e 's/code:18/9/' -e 's/code:19/0/' |
  sort -u | walker --dmenu -p 'Keybindings' --width 800) || exit 0
notify-send 'Keybinding' "$selection"
