#!/bin/bash
set -euo pipefail

selection=$(hyprctl binds -j | jq -r '
    def hasbit(n): ((. / n) | floor) % 2 == 1;
    .[]
    | select(.description != "")
    | ( [
          (if (.modmask | hasbit(64)) then "SUPER" else empty end),
          (if (.modmask | hasbit(4)) then "CTRL" else empty end),
          (if (.modmask | hasbit(8)) then "ALT" else empty end),
          (if (.modmask | hasbit(1)) then "SHIFT" else empty end)
        ] | join(" + ") ) as $mods
    | ((.key // "") as $k | if $k == "" then "code:\(.keycode)" else $k end) as $key
    | (if $mods == "" then $key else "\($mods) + \($key)" end) + "  →  " + .description
  ' | sort -u | walker --dmenu -p 'Keybindings' --width 800) || exit 0
notify-send 'Keybinding' "$selection"
