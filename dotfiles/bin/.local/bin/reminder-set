#!/bin/bash
when=$(gum input --prompt 'When (minutes or time)> ' --placeholder '15 or 15:30 or 3pm') || exit 0
[[ -n $when ]] || { notify-send 'Reminder' 'A time or number of minutes is required'; exit 1; }
message=$(gum input --prompt 'Message> ' --placeholder 'Reminder') || exit 0
reminder "$when" "$message"
