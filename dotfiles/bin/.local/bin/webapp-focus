#!/bin/bash
(( $# >= 2 )) || { echo "Usage: webapp-focus <window-pattern> <url>" >&2; exit 2; }
pattern=$1
shift
address=$(hyprctl clients -j | jq -r --arg pattern "$pattern" '.[] | select((.title | test($pattern; "i")) or (.class | test($pattern; "i"))) | .address' | head -1)
if [[ -n $address ]]; then
  hyprctl dispatch focuswindow "address:$address"
else
  webapp-launch "$@"
fi

